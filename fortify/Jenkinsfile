def scanProject(String jobName) {
    boolean collected = false
    catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE', catchInterruptions: false) {
        def scanBuild = build job: jobName, wait: true, propagate: false,
            parameters: [
                string(name: 'git_branch_name', value: params.git_branch_name),
                string(name: 'env', value: env.target_env),
            ]
        echo "${jobName} #${scanBuild.number}: ${scanBuild.result}"
        if (scanBuild.result != 'SUCCESS') {
            error("Scan failed: ${jobName} #${scanBuild.number} (${scanBuild.result})")
        }

        dir("collected/${jobName}") {
            deleteDir()
            copyArtifacts projectName: jobName,
                selector: specific("${scanBuild.number}"),
                filter: 'scan-output/**', fingerprintArtifacts: true
            sh '''
                set -eu
                set -- scan-output/reports/*_OWASPTop10.pdf
                if [ "$#" -ne 1 ] || [ ! -s "$1" ]; then
                    echo 'ERROR: Expected one non-empty OWASP Top 10 PDF' >&2
                    exit 1
                fi
                report_prefix="${1%_OWASPTop10.pdf}"
                for suffix in OWASPTop10.pdf OWASPTop10.html DeveloperWorkbook.pdf DeveloperWorkbook.html; do
                    test -s "${report_prefix}_$suffix"
                done
                test -n "$(find scan-output/artifacts -type f \\( -name '*.jar' -o -name '*.war' \\) -print -quit)"
                test -z "$(find scan-output/artifacts -type f -size 0 -print -quit)"
            '''
        }
        collected = true
    }
    return collected
}

def successfulProjects = []

pipeline {
    agent any
    options {
        timestamps()
        ansiColor('xterm')
        timeout(time: 6, unit: 'HOURS')
    }
    stages {
        stage('Apply Parameters') {
            steps {
                script {
                    if (params.size()>0) {
                        env.is_param_from_UI = 'true'
                        for (outputDir in ['collected', 'saved_artifacts', 'saved_reports']) {
                            dir(outputDir) {
                                deleteDir()
                            }
                        }
                        sh 'rm -f artifacts.tar.gz reports.tar.gz'
                        echo "Using params from jenkins UI"
                        if (params.git_branch_name == 'master') {
                            env.target_env = 'uat'
                            echo "Branch is master, override env to: ${env.target_env}"
                        } else {
                            env.target_env = 'sit'
                            echo "Using UI selected env: ${env.target_env}"
                        }
                    } else {
                        env.is_param_from_UI = 'false'
                        echo "Using params from pipeline"
                        properties([
                            parameters([
                                choice(name: 'git_branch_name', choices: ['sit', 'master'], description: '掃描分支。'),
                                booleanParam(name: 'is_release_utils', defaultValue: true, description: '是否Publish Utils ?'),
                                booleanParam(name: 'is_scan_fsap_adm', defaultValue: false, description: '是否掃描FSAP-ADM ?'),
								booleanParam(name: 'is_scan_fsap_runtime', defaultValue: false, description: '是否掃描 FSAP-RUNTIME ?'),
								booleanParam(name: 'is_scan_fsap_gateway', defaultValue: false, description: '是否掃描 FSAP-GATEWAY ?'),
								booleanParam(name: 'is_scan_fsap_model', defaultValue: false, description: '是否掃描 FSAP-MODEL ?'),
								booleanParam(name: 'is_scan_fsap_bpmn_utils', defaultValue: false, description: '是否掃描 FSAP-BPMN-UITLS ?'),
								booleanParam(name: 'is_scan_txcontrol', defaultValue: false, description: '是否掃描 TXCONTROL ?'),
								booleanParam(name: 'is_scan_ncl', defaultValue: false, description: '是否掃描 NCL ?'),
								booleanParam(name: 'is_scan_ncl_batch', defaultValue: false, description: '是否掃描 NCL-BATCH ?'),
								booleanParam(name: 'is_scan_fac', defaultValue: false, description: '是否掃描 FAC ?'),
								booleanParam(name: 'is_scan_ncb', defaultValue: false, description: '是否掃描 NCB ?'),
                                booleanParam(name: 'is_scan_fsap_month_report', defaultValue: false, description: '是否掃描 FSAP-MONTH-REPORT ?'),

                            ])
                        ])
                    }
                }
            }
        }

        stage('RELEASE-UTILS') {
            when {
                expression { return env.is_param_from_UI.toBoolean() && params.is_release_utils}
            }
            steps {
                catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE', catchInterruptions: false) {
                    build job: "FORTIFY-RELEASE-FSAP-FLOW-UTILS", wait: true,
                    parameters: [
                      string(name: 'git_branch_name', value: params.git_branch_name),
                      string(name: 'env', value: env.target_env),
                    ]
                }
            }
        }

        stage('FSAP-MODEL') {
            when {
                expression { return env.is_param_from_UI.toBoolean() && params.is_scan_fsap_model}
            }
            steps {
                script {
                    if (scanProject('FORTIFY-FSAP-MODEL')) {
                        successfulProjects.add('FORTIFY-FSAP-MODEL')
                    }
                }
            }
        }

        stage('FSAP-BPMN-UTILS') {
            when {
                expression { return env.is_param_from_UI.toBoolean() && params.is_scan_fsap_bpmn_utils}
            }
            steps {
                script {
                    if (scanProject('FORTIFY-FSAP-BPMN-UTILS')) {
                        successfulProjects.add('FORTIFY-FSAP-BPMN-UTILS')
                    }
                }
            }
        }

        stage('FSAP-RUNTIME') {
            when {
                expression { return env.is_param_from_UI.toBoolean() && params.is_scan_fsap_runtime}
            }
            steps {
                script {
                    if (scanProject('FORTIFY-FSAP-RUNTIME')) {
                        successfulProjects.add('FORTIFY-FSAP-RUNTIME')
                    }
                }
            }
        }

        stage('FSAP-ADM') {
            when {
                expression { return env.is_param_from_UI.toBoolean() && params.is_scan_fsap_adm}
            }
            steps {
                script {
                    if (scanProject('FORTIFY-FSAP-ADM')) {
                        successfulProjects.add('FORTIFY-FSAP-ADM')
                    }
                }
            }
        }

        stage('FSAP-GATEWAY') {
            when {
                expression { return env.is_param_from_UI.toBoolean() && params.is_scan_fsap_gateway}
            }
            steps {
                script {
                    if (scanProject('FORTIFY-FSAP-GATEWAY')) {
                        successfulProjects.add('FORTIFY-FSAP-GATEWAY')
                    }
                }
            }
        }

        stage('TXCONTROL') {
            when {
                expression { return env.is_param_from_UI.toBoolean() && params.is_scan_txcontrol}
            }
            steps {
                script {
                    if (scanProject('FORTIFY-TXCONTROL')) {
                        successfulProjects.add('FORTIFY-TXCONTROL')
                    }
                }
            }
        }
        
        stage('NCL') {
            when {
                expression { return env.is_param_from_UI.toBoolean() && params.is_scan_ncl}
            }
            steps {
                script {
                    if (scanProject('FORTIFY-NCL')) {
                        successfulProjects.add('FORTIFY-NCL')
                    }
                }
            }
        }

        stage('NCL-BATCH') {
            when {
                expression { return env.is_param_from_UI.toBoolean() && params.is_scan_ncl_batch}
            }
            steps {
                script {
                    if (scanProject('FORTIFY-NCL-BATCH')) {
                        successfulProjects.add('FORTIFY-NCL-BATCH')
                    }
                }
            }
        }

        stage('FAC') {
            when {
                expression { return env.is_param_from_UI.toBoolean() && params.is_scan_fac}
            }
            steps {
                script {
                    if (scanProject('FORTIFY-FAC')) {
                        successfulProjects.add('FORTIFY-FAC')
                    }
                }
            }
        }

        stage('NCB') {
            when {
                expression { return env.is_param_from_UI.toBoolean() && params.is_scan_ncb}
            }
            steps {
                script {
                    if (scanProject('FORTIFY-NCB')) {
                        successfulProjects.add('FORTIFY-NCB')
                    }
                }
            }
        }

        stage('FSAP-MONTH-REPORT') {
            when {
                expression { return env.is_param_from_UI.toBoolean() && params.is_scan_fsap_month_report}
            }
            steps {
                script {
                    if (scanProject('FORTIFY-FSAP-MONTH-REPORT')) {
                        successfulProjects.add('FORTIFY-FSAP-MONTH-REPORT')
                    }
                }
            }
        }

        stage('artifacts') {
            when {
                expression { return env.is_param_from_UI.toBoolean() }
            }
            steps {
                script {
                    if (successfulProjects.isEmpty()) {
                        echo 'No successful scan outputs collected; skipping archives.'
                    } else {
                        catchError(buildResult: 'UNSTABLE', stageResult: 'FAILURE', catchInterruptions: false) {
                            for (jobName in successfulProjects) {
                                withEnv(["FORTIFY_PROJECT=${jobName}"]) {
                                    sh '''
                                        set -eu
                                        mkdir -p saved_artifacts saved_reports
                                        cp -R "collected/$FORTIFY_PROJECT/scan-output/artifacts" "saved_artifacts/$FORTIFY_PROJECT"
                                        cp -R "collected/$FORTIFY_PROJECT/scan-output/reports" "saved_reports/$FORTIFY_PROJECT"
                                    '''
                                }
                            }
                            sh '''
                                set -eu
                                tar -czf artifacts.tar.gz -C saved_artifacts .
                                tar -czf reports.tar.gz -C saved_reports .
                            '''
                            archiveArtifacts artifacts: 'artifacts.tar.gz,reports.tar.gz', fingerprint: true
                        }
                    }
                }
            }
        }

    }
}
