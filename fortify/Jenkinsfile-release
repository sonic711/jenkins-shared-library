        stage('Apply Parameters') {
            steps {
                script {
                    if (params.size()>0) {
                        env.is_param_from_UI = 'true'
                        echo "Using params from jenkins UI"
                    } else {
                        env.is_param_from_UI = 'false'
                        echo "Using params from pipeline"
                        properties([
                            parameters([
                                choice(name: 'env', choices: ['sit', 'uat'], description: '掃描環境。'),
                                booleanParam(name: 'is_offline', defaultValue: true, description: '是否離線包版 ?'),
                            ])
                        ])
                    }
                }
            }
        }

        stage('BPMN-UTILS') {
            when {
                expression { return env.is_param_from_UI.toBoolean() }
            }
            steps {
                catchError(buildResult: 'SUCCESS', stageResult: 'FAILURE') {
                    build job: "FORTIFY-RELEASE-FSAP-BPMN-UTILS", wait: true,
                    parameters: [
                      string(name: 'env', value: params.env),
                      booleanParam(name: 'is_assemble', value: true),
                      booleanParam(name: 'is_test_report', value: false),
                      booleanParam(name: 'is_code_analysis', value: false),
